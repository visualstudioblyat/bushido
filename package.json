    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.0",
    "vue": "^3.5.44",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
